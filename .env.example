# ===== 爱发电（Afdian）配置 =====
# user_id：爱发电开发者后台显示（同一爱发电账号所有游戏共用）
AFDIAN_USER_ID=20765df8947211f1b18f52540025c377
# token：爱发电开发者后台「生成」的 token（切勿泄露、别提交到仓库）
AFDIAN_TOKEN=
# 本款游戏「完整版 ¥8」方案的 plan_id（在方案管理页获取，每款游戏不同）
AFDIAN_PLAN_ID=

# ===== 数据库（Supabase/Postgres 连接串） =====
# 用 Vercel 的 Transaction pooler（端口 6543）连接串
DATABASE_URL=postgres://user:pass@host:6543/dbname

# ===== 前端构建注入（Vercel 上不需要，GitHub Actions 构建时注入） =====
# 游戏部署在 GitHub Pages，跨域调 Vercel verify 端点，必须注入完整 URL
# VITE_AFDIAN_VERIFY_URL=https://my-game.vercel.app/api/afdian-verify
